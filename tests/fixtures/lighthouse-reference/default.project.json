{
  "name": "LighthouseKeeper",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "Remotes": {
        "$className": "Folder",
        "RefuelLamp": { "$className": "RemoteEvent" },
        "LampChanged": { "$className": "RemoteEvent" }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Workspace": {
      "Baseplate": {
        "$className": "Part",
        "$properties": { "Anchored": true, "Size": [512, 4, 512], "Position": [0, -2, 0] }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "CFrame": { "CFrame": { "position": [0, 0.5, 30], "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]] } }
        }
      },
      "Tower": {
        "$className": "Part",
        "$properties": { "Anchored": true, "Size": [4, 27, 4], "Position": [0, 13.5, 0] }
      },
      "Lamp": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [6, 6, 6],
          "CFrame": { "CFrame": { "position": [0, 30, 0], "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]] } },
          "Material": "Neon"
        },
        "Light": { "$className": "PointLight", "$properties": { "Range": 60, "Brightness": 1 } }
      },
      "OilCans": {
        "$className": "Folder",
        "Can1": { "$className": "Part", "$properties": { "Anchored": true, "Size": [2, 3, 2], "Position": [40, 1.5, 10] } },
        "Can2": { "$className": "Part", "$properties": { "Anchored": true, "Size": [2, 3, 2], "Position": [-35, 1.5, -20] } },
        "Can3": { "$className": "Part", "$properties": { "Anchored": true, "Size": [2, 3, 2], "Position": [15, 1.5, -45] } }
      }
    }
  }
}
